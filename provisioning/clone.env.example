# Copie pra clone.env e preencha com os dados do PROJETO NOVO do cliente.
# clone.env esta no .gitignore (nunca sobe pro git).

# --- Projeto Supabase novo ---
NEW_PROJECT_REF="abcdwxyz0000"
NEW_ANON_KEY="eyJ...anon_do_projeto_novo..."
NEW_SERVICE_ROLE_KEY="eyJ...service_role_do_projeto_novo..."
# Connection string do projeto novo (Settings > Database > Connection string > URI)
NEW_DB_URL="postgresql://postgres:SENHA@db.abcdwxyz0000.supabase.co:5432/postgres"

# --- Seed ---
ADMIN_EMAIL="dono@empresadocliente.com"   # precisa existir em Authentication > Add user

# --- Secrets de infra do edge (setados via supabase secrets set) ---
# NAO setar SUPABASE_URL / ANON / SERVICE_ROLE: o Supabase injeta sozinho.
# Gravacao de reuniao (LiveKit + storage):
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL=""
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="meeting-recordings"
S3_REGION="auto"
S3_PUBLIC_URL=""
# WhatsApp UAZAPI (token admin da conta do cliente):
